[Unit]
Description=Shared approval server for video pipelines (URL-based Telegram review, port 8477)
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/posting/approval
EnvironmentFile=-/root/.video-env
EnvironmentFile=-/root/fshorts/.env
EnvironmentFile=-/root/posting/approval/.env
ExecStart=/usr/bin/python3 /root/posting/approval/approval_server.py --serve
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
